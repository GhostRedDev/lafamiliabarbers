# Conector de reservas. Copiar a server/.env (modo 600, NUNCA en el frontend).
# En Vercel: Project Settings → Environment Variables (mismos nombres).
CONNEK_API_KEY_ID=ck_live_xxx
CONNEK_API_KEY_SECRET=ck_sec_xxx
# La API de socios vive en api.dev.connek.ca, rutas /v1/*.
CONNEK_API_BASE_URL=https://api.dev.connek.ca
CONNEK_GATEWAY_KEY=
# Servicio de Connek por cada servicio de la web (claves de src/content/services.ts).
CONNEK_SERVICES=coupe:000,coupe-barbe:000,enfant:000,enfant-barbe:000,degrade:000,degrade-barbe:000,rasage:000,rasage-barbe:000,barbe:000,serviette:000,facial:000,masque:000,cire:000,spray:000,tresses:000,twist:000,locs:000
CONNEK_SERVICE_ID=000
CONNEK_BOOKING_MINUTES=45
CONNEK_TZ=America/Toronto
CONNEK_MIN_LEAD_MINUTES=30
CONNEK_DEFAULT_COUNTRY_CODE=1
PORT=3023
# Resend = respaldo si Connek no respondió en absoluto.
RESEND_API_KEY=re_xxx
FROM_EMAIL=La Familia Barber <team@connek.ca>
BUSINESS_NOTIFY_EMAIL=
RESEND_MODE=fallback
